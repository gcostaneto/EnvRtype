Package: EnvRtype
Type: Package
Title: Envirotyping for Quantitative Genetics and Plant Breeding
Version: 0.1.0
Authors@R: c(
    person(
      "Germano", "Costa-Neto",
      email = "germano.cneto@gmail.com",
      role = c("aut", "cre")
    ),
    person(
      "Fernanda", "Pontes",
      email = "ferpoontes@gmail.com",
      role = "aut"
    )
